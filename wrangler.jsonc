{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-username-checker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/web"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-username-checker",
      "database_id": "e64eeafc-8ff4-49b8-9a30-e32404f30f31"
    }
  ],
  // The Workers Rate Limiting binding only supports period 10 or 60 (seconds), so the
  // 60 per 10 minutes target is approximated as 30 per 60s per IP (a search plus 6 suggestions is 7 calls). Confirm the binding
  // is available on the Free plan at deploy; fallback is one WAF rate-limiting rule.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
