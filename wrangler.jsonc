{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-username-checker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/web"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Placeholder: the owner creates the real database and replaces this id.
      "database_name": "dev-username-checker",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // The Workers Rate Limiting binding only supports period 10 or 60 (seconds), so the
  // 60 per 10 minutes target is approximated as 10 per 60s per IP. Confirm the binding
  // is available on the Free plan at deploy; fallback is one WAF rate-limiting rule.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
